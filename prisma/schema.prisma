generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  sub   String  @unique
  email String? @unique
  phone String? @unique
  role  String?

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  users         User[]
  agents        Agent[]
  agentVersions AgentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id                 String         @id @default(cuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name               String
  config             Json
  llmConfig          Json
  versions           AgentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AgentVersion {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  version     Int
  title       String
  description String?
  name        String
  config      Json
  llmConfig   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, version])
  @@index([workspaceId])
  @@index([agentId])
}
