generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  sub   String  @unique
  email String? @unique
  phone String? @unique
  role  String?

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  customVoices  Json?
  users         User[]
  agents        Agent[]
  agentVersions AgentVersion[]
  callRecords   CallRecord[]
  knowledgeBases KnowledgeBase[]
  twilioSubaccount TwilioSubaccount?
  telnyxManagedAccount TelnyxManagedAccount?
  sipTrunkConnections SipTrunkConnection[]
  phoneNumbers      PhoneNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TwilioSubaccount {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sipTrunkConnection SipTrunkConnection?

  sid             String  @unique
  authToken       String
  friendlyName    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model TelnyxManagedAccount {
  id                 String             @id @default(cuid())
  workspaceId        String             @unique
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sipTrunkConnection SipTrunkConnection?

  managedAccountId   String             @unique
  apiKey             String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model SipTrunkConnection {
  id                 String            @id @default(cuid())
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  twilioSubaccountId String?           @unique
  twilioSubaccount   TwilioSubaccount? @relation(fields: [twilioSubaccountId], references: [id], onDelete: Cascade)
  twilioTrunkSid     String?           @unique


  telnyxManagedAccountId String?       @unique
  telnyxManagedAccount   TelnyxManagedAccount? @relation(fields: [telnyxManagedAccountId], references: [id], onDelete: Cascade)
  telnyxConnectionId String?           @unique

  providerType       String

  terminationUri     String
  authUsername       String?
  authPassword       String?
  transport          String?
  phoneNumbers       PhoneNumber[]
  
  livekitOutboundTrunkId String?
  livekitInboundTrunkId  String?
  livekitDispatchRuleId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([twilioSubaccountId])
  @@index([telnyxManagedAccountId])
}

model PhoneNumber {
  id               String                  @id @default(cuid())
  workspaceId      String
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sipTrunkConnectionId String?
  sipTrunkConnection   SipTrunkConnection? @relation(fields: [sipTrunkConnectionId], references: [id], onDelete: Cascade)
  config           PhoneNumberConfig?

  phoneNumber    String                  @unique

  providerType   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([providerType])
  @@index([sipTrunkConnectionId])
}

model PhoneNumberConfig {
  id            String      @id @default(cuid())
  phoneNumberId String      @unique
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  nickname                   String?
  allowedInboundCountryList  Json?
  allowedOutboundCountryList Json?
  inboundAgents              Json?
  outboundAgents             Json?
  inboundWebhookUrl          String?
  inboundSmsWebhookUrl       String?
  fallbackNumber             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id                 String         @id @default(cuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name               String
  channel            String         @default("voice")
  config             Json
  llmConfig          Json
  versions           AgentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AgentVersion {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  version     Int
  title       String
  description String?
  name        String
  channel     String    @default("voice")
  config      Json
  llmConfig   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, version])
  @@index([workspaceId])
  @@index([agentId])
}

model CallRecord {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  call_type                    String?
  from_number                  String?
  to_number                    String?
  direction                    String?
  call_id                      String    @unique
  agent_id                     String?
  agent_version                Int?
  call_status                  String    @default("registered")

  metadata                     Json?
  retell_llm_dynamic_variables Json?
  collected_dynamic_variables  Json?
  custom_sip_headers           Json?
  data_storage_setting          String?
  opt_in_signed_url            Boolean?
  start_timestamp              BigInt?
  end_timestamp                BigInt?
  transfer_end_timestamp       BigInt?
  duration_ms                  Int?
  transcript                   String?

  transcript_object            Json?
  transcript_with_tool_calls   Json?
  
  recording_url                         String?
  recording_multi_channel_url           String?
  public_log_url                         String?
  knowledge_base_retrieved_contents_url  String?

  latency                               Json?

  disconnection_reason                   String?
  transfer_destination                   String?
  
  call_analysis                          Json?
  call_cost                              Json?
  llm_token_usage                        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, start_timestamp])
  @@index([call_status])
}

model KnowledgeBase {
  id                  String                @id @default(cuid())
  workspaceId         String
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name                String
  sources             KnowledgeBaseSource[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, name])
}

model KnowledgeBaseSource {
  id               String                   @id @default(cuid())
  knowledgeBaseId  String
  knowledgeBase    KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  type             String                   @default("document")
  filename         String
  fileUrl          String?
  fileSize         Int?

  status           String?
  ingestionJobId   String?
  lastIngestedAt   DateTime?

  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([knowledgeBaseId])
  @@index([knowledgeBaseId, type])
  @@index([ingestionJobId])
}
