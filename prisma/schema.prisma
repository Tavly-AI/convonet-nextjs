generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  sub   String  @unique
  email String? @unique
  phone String? @unique
  role  String?

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  customVoices  Json?
  users         User[]
  agents        Agent[]
  agentVersions AgentVersion[]
  twilioSubaccount TwilioSubaccount?
  twilioSipTrunk   TwilioSipTrunk?
  twilioPhoneNumbers TwilioPhoneNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TwilioSubaccount {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sipTrunk    TwilioSipTrunk?

  sid             String  @unique
  authToken       String
  friendlyName    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model TwilioSipTrunk {
  id                 String           @id @default(cuid())
  workspaceId        String           @unique
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  twilioSubaccountId String           @unique
  twilioSubaccount   TwilioSubaccount @relation(fields: [twilioSubaccountId], references: [id], onDelete: Cascade)

  trunkSid          String  @unique
  terminationUri    String
  credentialListSid String
  authUsername      String
  authPassword      String
  originationUrlSid String
  phoneNumbers      TwilioPhoneNumber[]
  
  livekitOutboundTrunkId String?
  livekitInboundTrunkId  String?
  livekitDispatchRuleId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([twilioSubaccountId])
}

model TwilioPhoneNumber {
  id               String         @id @default(cuid())
  workspaceId      String
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  twilioSipTrunkId String
  twilioSipTrunk   TwilioSipTrunk @relation(fields: [twilioSipTrunkId], references: [id], onDelete: Cascade)
  config           TwilioPhoneNumberConfig?

  phoneNumber    String @unique
  phoneNumberSid String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([twilioSipTrunkId])
}

model TwilioPhoneNumberConfig {
  id                  String            @id @default(cuid())
  twilioPhoneNumberId String            @unique
  twilioPhoneNumber   TwilioPhoneNumber @relation(fields: [twilioPhoneNumberId], references: [id], onDelete: Cascade)

  nickname                   String?
  allowedInboundCountryList  Json?
  allowedOutboundCountryList Json?
  inboundAgents              Json?
  outboundAgents             Json?
  inboundWebhookUrl          String?
  inboundSmsWebhookUrl       String?
  fallbackNumber             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id                 String         @id @default(cuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name               String
  channel            String         @default("voice")
  config             Json
  llmConfig          Json
  versions           AgentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AgentVersion {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  version     Int
  title       String
  description String?
  name        String
  channel     String    @default("voice")
  config      Json
  llmConfig   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, version])
  @@index([workspaceId])
  @@index([agentId])
}
